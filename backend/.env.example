# Copy this file to .env and fill in real values. .env is gitignored.

# Groq API key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Optional — only used by eval/judge.py as an independent grader (a different provider
# than the one generating the reports, so the eval harness isn't grading its own output).
# Get one at https://aistudio.google.com/apikey — if unset, judge_report() will fail per
# case with an auth error, recorded in that case's "judge" field; the run itself still
# completes since eval/run_eval.py catches judge failures individually.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_JUDGE_MODEL=gemini-3.6-flash

# Fundamentals data: https://finnhub.io/register (free tier)
FINNHUB_API_KEY=your_finnhub_api_key_here
# Price history / technicals: https://twelvedata.com (free "Basic" tier)
TWELVEDATA_API_KEY=your_twelvedata_api_key_here

# Max tickers accepted in a single portfolio/comparison request
MAX_TICKERS=5

# Per external call timeout (yfinance / DuckDuckGo / Groq), in seconds
REQUEST_TIMEOUT_SECONDS=20

LOG_LEVEL=INFO
ENVIRONMENT=development
