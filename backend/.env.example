# Copy this file to .env and fill in real values. .env is gitignored.

# Groq API key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Fundamentals data: https://finnhub.io/register (free tier)
FINNHUB_API_KEY=your_finnhub_api_key_here
# Price history / technicals: https://twelvedata.com (free "Basic" tier)
TWELVEDATA_API_KEY=your_twelvedata_api_key_here

# Max tickers accepted in a single portfolio/comparison request
MAX_TICKERS=5

# Per external call timeout (yfinance / DuckDuckGo / Groq), in seconds
REQUEST_TIMEOUT_SECONDS=20

LOG_LEVEL=INFO
ENVIRONMENT=development
